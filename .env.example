# Copy to .env (git-ignored) and change values. Local development only — never real secrets.

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=caterly
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=caterly
POSTGRES_PORT=5432

# Backend connection string (read by ASP.NET Core from the environment once persistence exists).
# Prefer `dotnet user-secrets` in backend/src/Caterly.Api for per-developer values.
ConnectionStrings__Caterly=Host=localhost;Port=5432;Database=caterly;Username=caterly;Password=change-me-local-only

# Web
VITE_API_BASE_URL=http://localhost:5080
